rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isPartner(uid) {
      // A partner can read if the target user has them registered as partnerUid
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.partnerUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // /users/{uid}
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Only the owner can read/write their profile
      allow read: if isOwner(uid) || isPartner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // Profiles are never deleted client-side

      // ── Subcolección: dependents ──
      match /dependents/{dependentId} {
        allow read, write: if isOwner(uid);
      }

      // ── Subcolección: medical_files ──
      match /medical_files/{fileId} {
        allow read: if isOwner(uid) || isPartner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Subcolección: medications ──
      match /medications/{medId} {
        allow read, write: if isOwner(uid);
      }

      // ── Subcolección: appointments ──
      match /appointments/{aptId} {
        allow read: if isOwner(uid) || isPartner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Subcolección: cycle_logs ──
      match /cycle_logs/{logId} {
        // The partner (male) can read cycle data only if linked
        allow read: if isOwner(uid) || isPartner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Subcolección: vaccines ──
      match /vaccines/{vaccineId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // /glossary_cache/{termHash}
    // ─────────────────────────────────────────────────────────────
    match /glossary_cache/{termHash} {
      // Any authenticated user can read the medical glossary cache
      allow read: if isAuthenticated();
      // Only allow server-side writes (Cloud Functions) — deny from client
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // /partner_requests/{requestId}
    // ─────────────────────────────────────────────────────────────
    match /partner_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }
  }
}
